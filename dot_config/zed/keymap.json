// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "bindings": {
            "cmd-,": "workspace::ActivatePaneLeft",
            "cmd-.": "workspace::ActivatePaneRight",
            "ctrl-cmd-right": "pane::GoForward",
            "ctrl-cmd-left": "pane::GoBack",
            "cmd-g": "go_to_line::Toggle",
            "cmd-:": "pane::SplitRight",
            "cmd-;": "pane::SplitLeft",
            "alt-up": "editor::MoveToEnclosingBracket"
        }
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
        }
    },
    {
        "bindings": {
            "cmd-_": "dev::OpenZeta2ContextView"
        }
    },
    {
        "bindings": {
            "alt-shift-down": "vim::NextMethodStart"
        }
    },
    {
        "bindings": {
            "alt-shift-up": "vim::PreviousMethodStart"
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "cmd-p": "git::Push"
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "cmd-shift-p": "git::ForcePush"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "cmd-p": "file_finder::Toggle"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-p": null
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-shift-l": "git_panel::ToggleFocus"
        }
    }
]
